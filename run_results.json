{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.11.7", "generated_at": "2026-04-07T00:52:36.368756Z", "invocation_id": "05c8e10d-0c26-4345-b4a1-574971e59754", "invocation_started_at": "2026-04-07T00:52:33.168061Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-04-07T00:52:36.122050Z", "completed_at": "2026-04-07T00:52:36.129198Z"}, {"name": "execute", "started_at": "2026-04-07T00:52:36.129608Z", "completed_at": "2026-04-07T00:52:36.129621Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0085601806640625, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.plant_sensor_dbt.vw_leituras_silver", "compiled": true, "compiled_code": "\n\nSELECT \n    id,\n    -- Converte o hor\u00e1rio para SP e salva como timestamp limpo (sem fuso)\n    data_ingestao AT TIME ZONE 'America/Sao_Paulo' AS data_leitura_sp,\n    \n    -- Extrai as chaves do JSON e j\u00e1 converte para o tipo correto (N\u00famero)\n    (dados_json->>'temperature_c')::NUMERIC AS temperatura_c,\n    (dados_json->>'humidity_pct')::NUMERIC AS umidade_ar_pct,\n    (dados_json->>'soil_moisture_raw')::INT AS umidade_solo_raw,\n    (dados_json->>'light_intensity_raw')::NUMERIC AS luz_raw,\n    \n    arquivo_origem AS dispositivo\nFROM \n    \"postgres\".\"public\".\"leituras_brutas_bronze\"", "relation_name": "\"postgres\".\"public\".\"vw_leituras_silver\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-04-07T00:52:36.132153Z", "completed_at": "2026-04-07T00:52:36.133509Z"}, {"name": "execute", "started_at": "2026-04-07T00:52:36.133953Z", "completed_at": "2026-04-07T00:52:36.133962Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.003209352493286133, "adapter_response": {}, "message": null, "failures": null, "unique_id": "seed.plant_sensor_dbt.cadastro_sensores", "compiled": null, "compiled_code": null, "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-04-07T00:52:36.135943Z", "completed_at": "2026-04-07T00:52:36.137229Z"}, {"name": "execute", "started_at": "2026-04-07T00:52:36.137670Z", "completed_at": "2026-04-07T00:52:36.137679Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.002645254135131836, "adapter_response": {}, "message": null, "failures": null, "unique_id": "seed.plant_sensor_dbt.limites_plantas_cientifico", "compiled": null, "compiled_code": null, "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-04-07T00:52:36.139754Z", "completed_at": "2026-04-07T00:52:36.150093Z"}, {"name": "execute", "started_at": "2026-04-07T00:52:36.150519Z", "completed_at": "2026-04-07T00:52:36.150529Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.011819124221801758, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.plant_sensor_dbt.not_null_vw_leituras_silver_data_leitura_sp.98169cdcfe", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect data_leitura_sp\nfrom \"postgres\".\"public\".\"vw_leituras_silver\"\nwhere data_leitura_sp is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-04-07T00:52:36.152531Z", "completed_at": "2026-04-07T00:52:36.156134Z"}, {"name": "execute", "started_at": "2026-04-07T00:52:36.156539Z", "completed_at": "2026-04-07T00:52:36.156547Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.004912376403808594, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.plant_sensor_dbt.not_null_vw_leituras_silver_dispositivo.1fc45f5233", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect dispositivo\nfrom \"postgres\".\"public\".\"vw_leituras_silver\"\nwhere dispositivo is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success"